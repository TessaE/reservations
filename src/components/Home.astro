---
import { Environment } from "../lib/environments";

interface Props {
  reservations: any[] | null;
  error: any;
}

const { reservations, error } = Astro.props;

function getReservation(env: string) {
  return reservations?.find((r) => r.environment === env) ?? null;
}
---

<main>
  <h1>Test Environments</h1>

  <div class="controls">
    <div class="name-input">
      <label for="user-name">Your name:</label>
      <input type="text" id="user-name" placeholder="Enter your name" maxlength="50" />
    </div>
    <div class="duration-input">
      <label for="reserve-duration">Reserve for:</label>
      <select id="reserve-duration">
        <option value="60">1 hour</option>
        <option value="120" selected>2 hours</option>
        <option value="240">4 hours</option>
        <option value="eod">The rest of the day</option>
      </select>
    </div>
  </div>

  {error && <p>Error loading reservations: {error.message}</p>}

  <div class="list-envs">
    {Object.values(Environment).map((env) => {
      const reservation = getReservation(env);
      return (
        <>
          {reservation ? (
            <div class="env-card" data-expires={reservation.reserved_until}>
              <h2>{env}</h2>
              <div class="env-text">
                <p><strong>Reserved by:</strong> {reservation.reserved_by}</p>
                <p><strong>From:</strong> <span class="format-date" data-timestamp={reservation.reserved_from}></span></p>
                <p><strong>Until:</strong> <span class="format-date" data-timestamp={reservation.reserved_until}></span></p>
              </div>
              <button class="reserve-btn" data-env={env} data-has-reservation="true" data-reserved-by={reservation.reserved_by}>Claim</button>
              <button class="end-reservation-btn" data-env={env} data-reserved-by={reservation.reserved_by} hidden>End reservation</button>
            </div>
          ) : (
            <div class="env-card">
              <h2>{env}</h2>
              <div class="env-text">
                <p class="free-label">FREE</p>
              </div>
              <button class="reserve-btn" data-env={env} data-has-reservation="false">Claim</button>
            </div>
          )}
        </>
      );
    })}
  </div>
</main>

<dialog id="confirm-dialog">
  <p>Are you sure you want to override this reservation? <span id="confirm-name" class="bold"></span> might be angry!</p>
  <div class="button-bar">
    <button id="confirm-no">Cancel</button>
    <button id="confirm-yes">Yes, override</button>
  </div>
</dialog>

<script src="../scripts/main.ts"></script>
